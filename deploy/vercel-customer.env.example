# Vercel environment variables for atelier-customer.

# MonsterASP.NET Free uses HTTP, so expose the API through a Vercel rewrite.
NEXT_PUBLIC_API_URL=/api
API_PROXY_ORIGIN=http://atelierapi.runasp.net

# Use this instead if the backend has HTTPS:
# NEXT_PUBLIC_API_URL=https://<api-host>/api

NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=<facebook-app-id>
