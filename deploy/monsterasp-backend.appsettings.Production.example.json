{
  "ConnectionStrings": {
    "DefaultConnection": "Server=db64085.databaseasp.net;Database=db64085;User Id=db64085;Password=YOUR_DB_PASSWORD;Encrypt=False;MultipleActiveResultSets=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://<customer-project>.vercel.app",
      "https://<admin-project>.vercel.app"
    ]
  },
  "Frontend": {
    "BaseUrl": "https://<customer-project>.vercel.app"
  },
  "TimeZone": {
